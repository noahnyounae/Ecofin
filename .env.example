# Copier ce fichier vers .env et le renseigner.
# .env est exclu du dépôt et du contexte de build : rien de ce qui suit ne doit
# être committé.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Tunnel Cloudflare
# ---------------------------------------------------------------------------
#
# Cloudflare Zero Trust → Networks → Tunnels → ton tunnel → Configure.
# L'installation « Docker » affiche une commande contenant --token <VALEUR> ;
# reporter cette valeur seule, sans le préfixe --token.
#
# Dans l'onglet « Public Hostname » du même tunnel :
#   Subdomain / Domain : ecofin.exemple.eu
#   Service            : HTTP → ecofin:8484
#
# `ecofin:8484`, surtout pas `localhost:8484` : dans un conteneur, localhost
# désigne cloudflared lui-même, et le retour d'autorisation part en 502.

CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Application Enable Banking
# ---------------------------------------------------------------------------
#
# Identifiant affiché sur https://enablebanking.com/cp/ après l'enregistrement
# de l'application. Renseigné ici, il évite d'avoir à lancer `auth login`.

ECOFIN_APPLICATION_ID=

# Chemin de la clé privée VU DEPUIS LE CONTENEUR.
#
# Déposer le fichier dans ./secrets/ sur l'hôte, puis le protéger :
#
#   mkdir -p secrets
#   cp ~/Downloads/<fichier>.pem secrets/enablebanking.pem
#   chmod 600 secrets/enablebanking.pem
#
# Le répertoire est monté en lecture seule sur /run/secrets : la clé ne quitte
# jamais l'hôte et n'entre ni dans une image ni dans un volume. Le chmod 600
# n'est pas décoratif — ecofin refuse de lire une clé accessible à d'autres.

ECOFIN_PRIVATE_KEY=/run/secrets/enablebanking.pem

# URL de retour, identique à celle déclarée dans « Allowed redirect URLs » côté
# Enable Banking, et servie par le tunnel ci-dessus. Le schéma https:// est
# obligatoire ; http:// est refusé, y compris pour localhost.

ECOFIN_REDIRECT_URL=https://ecofin.exemple.eu/callback

# Adresse d'écoute du serveur qui reçoit le retour d'autorisation.
# Dans un conteneur il faut 0.0.0.0 : sur la boucle locale, ni le tunnel ni le
# port publié n'atteindraient le listener.

ECOFIN_LISTEN=0.0.0.0:8484

# ---------------------------------------------------------------------------
# Application web
# ---------------------------------------------------------------------------
#
# L'accès est protégé par un compte, créé depuis le CLI :
#
#   docker compose run --rm ecofin user add <ton-adresse>
#
# Cette commande crée aussi le secret qui signe les sessions. Le serveur web
# monte la base en lecture seule et ne peut pas s'en charger lui-même.
#
# À ne renseigner que pour un accès direct en http://localhost : les cookies de
# session sont marqués `Secure` par défaut, et un navigateur ne les renvoie
# jamais sur une connexion non chiffrée.

ECOFIN_INSECURE_COOKIES=
